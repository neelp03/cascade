<clickhouse>
    <!-- Allow connections from all interfaces inside Docker network -->
    <listen_host>0.0.0.0</listen_host>

    <!--
        Skip validation that rejects user-level settings placed at top level.
        User-level settings (memory limits, async_insert, etc.) belong in
        users.xml <profiles> — see infra/clickhouse/users.xml.
    -->
    <skip_check_for_incorrect_settings>1</skip_check_for_incorrect_settings>
</clickhouse>
