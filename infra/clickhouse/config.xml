<clickhouse>
    <!-- Allow connections from all interfaces inside Docker network -->
    <listen_host>0.0.0.0</listen_host>

    <!-- Reduce memory for local dev -->
    <max_memory_usage>2000000000</max_memory_usage>
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>

    <!-- Faster async inserts for the writer service -->
    <async_insert>1</async_insert>
    <async_insert_max_data_size>1000000</async_insert_max_data_size>
    <async_insert_busy_timeout_ms>500</async_insert_busy_timeout_ms>
</clickhouse>
