<clickhouse>
    <profiles>
        <default>
            <!-- Memory limit per query for local dev -->
            <max_memory_usage>2000000000</max_memory_usage>

            <!-- Async inserts for the writer service batch path -->
            <async_insert>1</async_insert>
            <async_insert_max_data_size>1000000</async_insert_max_data_size>
            <async_insert_busy_timeout_ms>500</async_insert_busy_timeout_ms>
        </default>
    </profiles>
</clickhouse>
